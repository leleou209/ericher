{
  "name": "hr-desk",
  "description": "ericher 接待台：跑在 Cloudflare Workers 上的单人 AI 接待台（Agents SDK + Durable Objects + React）",
  "version": "0.1.7.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "release:pack": "node scripts/make-release.mjs",
    "types": "wrangler types",
    "tail": "wrangler tail",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-startup-bundle.mjs",
    "ship": "node scripts/ship.mjs",
    "ship:gate": "node scripts/ship.mjs gate",
    "ship:next": "node scripts/ship.mjs next",
    "ship:pack": "node scripts/ship.mjs pack",
    "ship:deploy": "node scripts/ship.mjs deploy",
    "ship:git": "node scripts/ship.mjs git --yes",
    "test:web-encoding": "node scripts/test-web-encoding.mjs",
    "test:chat-recovery": "npm run build && node scripts/test-chat-recovery.mjs",
    "test:weak-network": "npm run build && node scripts/test-weak-network.mjs",
    "probe:email": "node scripts/probe-email.mjs",
    "feed:mail": "node scripts/feed-mail.mjs",
    "fixture:weak-network": "node scripts/start-weak-network-fixture.mjs",
    "fixture:weak-network:stop": "node scripts/stop-weak-network-fixture.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.118",
